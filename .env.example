# Flask Configuration
FLASK_SECRET_KEY=replace-with-a-secure-random-secret-key

# Option 1: Single Connection String (Recommended for Cloud / Render)
# Example for TiDB Cloud or Aiven:
# DATABASE_URL=mysql://user:password@gateway.tidbcloud.com:4000/edutrack?ssl-mode=REQUIRED

# Option 2: Individual Connection Variables
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=student_performance_db

# SSL Mode (true for cloud databases, false for local MySQL)
DB_SSL=false
